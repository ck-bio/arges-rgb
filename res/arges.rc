#include <windows.h>
#include "../src/version.h"

1 ICON "ico/arges_active.ico"
2 ICON "ico/arges_paused.ico"
3 RCDATA "res/default.ini"
2 24 "res/settings.manifest" /* common controls 6, switched on only for the settings window */

101 DIALOGEX 0, 0, 428, 200
STYLE DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Arges RGB settings"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
END

102 DIALOGEX 0, 0, 300, 166
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Edit profiles"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
END

1 VERSIONINFO
FILEVERSION ARGES_VERSION_NUMBER
PRODUCTVERSION ARGES_VERSION_NUMBER
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Arges RGB"
      VALUE "ProductName", "Arges RGB"
      VALUE "FileVersion", ARGES_VERSION
      VALUE "ProductVersion", ARGES_VERSION
      VALUE "OriginalFilename", "arges.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
